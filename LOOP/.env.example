# LOOP — copy to .env at the repository root. Never commit the real .env file.

# Runtime
NODE_ENV=development
PORT=4000
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
TRUST_PROXY=0
CORS_ORIGIN=http://localhost:5173

# MySQL 8.4 LTS recommended (8.0.19+ supported).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=loop
# Owner account: migrations, backups and `npm run admin:provision` only. The API never uses it.
DB_OWNER_USER=loop_owner
DB_OWNER_PASSWORD=replace-with-owner-password
# Least-privilege account the API connects with.
DB_APP_USER=loop_app
DB_APP_PASSWORD=replace-with-app-password
DB_APP_HOST=localhost
DB_TIMEZONE=+05:30
DB_SSL=false
# DB_SSL_CA=/path/to/ca.pem
DB_POOL_MAX=12
DB_CONNECT_TIMEOUT_MS=10000

# Background jobs (persistent hosts only; never on Vercel Functions)
JOBS_ENABLED=true
SESSION_IDLE_MINUTES=30

# LOOP-owned audio. Only rights-cleared recordings, registered by an Admin or
# published from an approved Artist upload, are ever streamed. Serverless hosts
# always run with local media disabled.
LOCAL_MEDIA_ENABLED=true
LOCAL_MEDIA_DIR=./media

# Artist uploads (quarantine lives under LOCAL_MEDIA_DIR; ClamAV + ffprobe are required to approve)
ARTIST_UPLOAD_MAX_BYTES=52428800
ARTIST_STORAGE_QUOTA_BYTES=524288000
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
FFPROBE_PATH=ffprobe

# Rate limits
RATE_LIMIT_AUTH_FAILURES=20
RATE_LIMIT_WRITES_PER_MIN=240
